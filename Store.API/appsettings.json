{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServerConnection": "Server=localhost,1433;Database=store;User Id=sa;Password=Jose1234&;TrustServerCertificate=True;"
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://admin:secret@localhost:27017/?authSource=admin",
    "DatabaseName": "storeRead"
  },
  "Kafka": {
    "Producer": {
      "BootstrapServers": "localhost:9092",
      "Acks": "all",
      "Retries": 3,
      "RetryBackoffMs": 1000,
      "LingerMs": 5,
      "EnableIdempotence": true
    },
    "Consumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "address-projection-group",
      "Topics": [
        "addresses.created",
        "addresses.updated",
        "users.created",
        "users.updated",
        "products.created",
        "products.updated",
        "categories.created",
        "categories.updated",
        "locations.created",
        "locations.updated"
      ],
      "AutoOffsetReset": "earliest",
      "EnableAutoCommit": false,
      "ConsumeTimeoutMs": 5000
    }
  }
}
